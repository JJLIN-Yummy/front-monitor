<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.web3d.mapper.SysUserMapper">
    <sql id="columns">
        id,user_name,user_email,user_password,user_phone,is_valid
    </sql>


    <select id="getUserInfo" resultType="com.web3d.entity.system.SysUser">
        SELECT <include refid="columns"/>
            FROM  user
            WHERE user_phone = #{userPhone};
    </select>


    <insert id="insertUser" parameterType="com.web3d.entity.bo.SignupBo">
        INSERT INTO user (id, user_name, user_password,user_email,user_phone)
        VALUES (#{id}, #{userName}, #{userPassword}, #{userEmail}, #{userPhone})
    </insert>

    <update id="updateUser" parameterType="com.web3d.entity.bo.UserBo">
        update user set

        <if test="userName != null">
            user_name = #{userName}
        </if>

        <if test="token != null">
            token = #{token}
        </if>

        <where>
            id = #{id}
        </where>
    </update>





</mapper>